# Copy to .env and fill in. .env is gitignored - never commit it.

# Upstox access token, used for market data only (v3 historical-candle).
# The screener never places orders. Get one from the Upstox developer
# console; tokens expire, so refresh it when scans start returning 401.
UPSTOX_TOKEN=

# Optional. NSE hourly bars are 09:15-15:30, which leaves a 15-minute
# remainder that TradingView folds into the 14:15 candle. The screener
# does the same so its numbers match the chart. Set to 0 to keep Upstox's
# own seven-bar sessions instead.
SCREENER_FOLD_STUB=1
